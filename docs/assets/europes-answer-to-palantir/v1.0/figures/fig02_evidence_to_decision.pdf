<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:cc="http://creativecommons.org/ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:pdf="http://ns.adobe.com/pdf/1.3/" xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:x="adobe:ns:meta/" xmlns:xmp="http://ns.adobe.com/xap/1.0/" xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"><rdf:RDF><rdf:Description rdf:about=""><dc:title><rdf:Alt><rdf:li xml:lang="x-default">A valve-release decision explained</rdf:li></rdf:Alt></dc:title><dc:description><rdf:Alt><rdf:li xml:lang="x-default">A proposed valve-release example shows how heterogeneous records become decision-relevant evidence. The graph links the subject, measurement, source and applicable rule. Verification and policy checks determine whether the evidence may support the task; AI explains the accepted facts, while the responsible participant controls the operation. A valid signature does not establish truth. Missing evidence can require HOLD. This is an illustrative workflow, not a validated safety case or a reported industrial deployment.</rdf:li></rdf:Alt></dc:description><dc:creator><rdf:Seq><rdf:li>Dr. Carsten StÃ¶cker</rdf:li></rdf:Seq></dc:creator><dc:subject><rdf:Bag><rdf:li>Industrial AI</rdf:li><rdf:li>Evidence graphs</rdf:li><rdf:li>Semantic interoperability</rdf:li></rdf:Bag></dc:subject><dc:rights><rdf:Alt><rdf:li xml:lang="x-default">Copyright 2026 Dr. Carsten StÃ¶cker, Spherity GmbH. CC BY 4.0 except where otherwise noted.</rdf:li></rdf:Alt></dc:rights><dc:publisher><rdf:Bag><rdf:li>Spherity GmbH</rdf:li></rdf:Bag></dc:publisher><dc:language><rdf:Bag><rdf:li>en</rdf:li></rdf:Bag></dc:language><dc:identifier>https://spherity.github.io/spherity-research/europes-answer-to-palantir.html#figure-11-figure</dc:identifier><dc:relation><rdf:Bag><rdf:li>https://spherity.github.io/spherity-research/europes-answer-to-palantir.html</rdf:li></rdf:Bag></dc:relation><dc:format>application/pdf</dc:format><pdf:Keywords>Industrial AI; Evidence graphs; Semantic interoperability</pdf:Keywords><xmpRights:Marked>True</xmpRights:Marked><xmpRights:WebStatement>https://creativecommons.org/licenses/by/4.0/</xmpRights:WebStatement><xmpRights:UsageTerms><rdf:Alt><rdf:li xml:lang="x-default">CC BY 4.0. Referenced third-party material retains its own terms.</rdf:li></rdf:Alt></xmpRights:UsageTerms><photoshop:Credit>Dr. Carsten StÃ¶cker / Spherity GmbH</photoshop:Credit><cc:attributionURL>https://spherity.github.io/spherity-research/europes-answer-to-palantir.html</cc:attributionURL><cc:license>https://creativecommons.org/licenses/by/4.0/</cc:license><xmp:ModifyDate>2026-11-01T18:33:53Z</xmp:ModifyDate><xmp:MetadataDate>2026-11-01T18:33:53Z</xmp:MetadataDate><dc:date><rdf:Seq><rdf:li>2026-11-01</rdf:li></rdf:Seq></dc:date><pdf:Producer>ReportLab PDF Library - (opensource)</pdf:Producer></rdf:Description></rdf:RDF></x:xmpmeta>
