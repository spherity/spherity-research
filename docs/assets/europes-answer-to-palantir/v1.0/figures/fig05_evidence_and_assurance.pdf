<x:xmpmeta xmlns:cc="http://creativecommons.org/ns#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:pdf="http://ns.adobe.com/pdf/1.3/" xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:x="adobe:ns:meta/" xmlns:xmp="http://ns.adobe.com/xap/1.0/" xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"><rdf:RDF><rdf:Description rdf:about=""><dc:title><rdf:Alt><rdf:li xml:lang="x-default">From evidence admission to bounded assurance</rdf:li></rdf:Alt></dc:title><dc:description><rdf:Alt><rdf:li xml:lang="x-default">Evidence admission preserves the original assertion and checks its interpretation, issuer authority, status and permitted use before it supports a bounded argument. Authorized action remains a separate responsibility. The diagram is an analytical design, not a claim that a signature or graph proves a physical system safe. Status and profile changes may require reassessment of dependent decisions.</rdf:li></rdf:Alt></dc:description><dc:creator><rdf:Seq><rdf:li>Dr. Carsten StÃ¶cker</rdf:li></rdf:Seq></dc:creator><dc:subject><rdf:Bag><rdf:li>Industrial AI</rdf:li><rdf:li>Evidence graphs</rdf:li><rdf:li>Semantic interoperability</rdf:li></rdf:Bag></dc:subject><dc:rights><rdf:Alt><rdf:li xml:lang="x-default">Copyright 2026 Dr. Carsten StÃ¶cker, Spherity GmbH. CC BY 4.0 except where otherwise noted.</rdf:li></rdf:Alt></dc:rights><dc:publisher><rdf:Bag><rdf:li>Spherity GmbH</rdf:li></rdf:Bag></dc:publisher><dc:language><rdf:Bag><rdf:li>en</rdf:li></rdf:Bag></dc:language><dc:identifier>https://spherity.github.io/spherity-research/europes-answer-to-palantir.html#figure-05-figure</dc:identifier><dc:relation><rdf:Bag><rdf:li>https://spherity.github.io/spherity-research/europes-answer-to-palantir.html</rdf:li></rdf:Bag></dc:relation><dc:format>application/pdf</dc:format><pdf:Keywords>Industrial AI; Evidence graphs; Semantic interoperability</pdf:Keywords><xmpRights:Marked>True</xmpRights:Marked><xmpRights:W