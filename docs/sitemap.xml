---
layout: null
permalink: /sitemap.xml
---
{%- comment -%}The post-build generator replaces this rendered template with a
deterministic sitemap. Liquid whitespace control keeps this fallback XML
declaration at byte zero without invalidating Jekyll front matter.{%- endcomment -%}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in site.pages %}
{% if item.url == "/" or item.url contains ".html" %}
{% unless item.url == "/404.html" %}
{% assign item_modified = item.last_modified_at | default: item.date | default: site.time %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ item_modified | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>{% if item.url == "/" %}1.0{% else %}0.8{% endif %}</priority>
  </url>
{% endunless %}
{% endif %}
{% endfor %}
{% for file in site.static_files %}
{% if file.extname == ".html" or file.extname == ".pdf" %}
{% unless file.path contains "/google" %}
{% assign file_modified = file.modified_time | default: site.time %}
  <url>
    <loc>{{ file.path | absolute_url | xml_escape }}</loc>
    <lastmod>{{ file_modified | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>{% if file.extname == ".pdf" %}0.7{% else %}0.8{% endif %}</priority>
  </url>
{% endunless %}
{% endif %}
{% endfor %}
</urlset>
